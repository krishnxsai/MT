rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // MediTrack Security Rules - Production Ready
    // ============================================

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if request is from document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Get user document
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Helper function: Check if current user is a doctor
    function isDoctor() {
      return isAuthenticated() &&
             getUserData(request.auth.uid).role == 'DOCTOR';
    }

    // Helper function: Check if current user is an admin
    function isAdmin() {
      return isAuthenticated() &&
             getUserData(request.auth.uid).role == 'ADMIN';
    }

    // Helper function: Check if current user is a pharmacy
    function isPharmacy() {
      return isAuthenticated() &&
             getUserData(request.auth.uid).role == 'PHARMACY';
    }

    // Helper function: Check if current user's account is APPROVED
    // Requires explicit status field — missing status is NOT treated as approved
    function isApproved() {
      let userData = getUserData(request.auth.uid);
      return 'status' in userData && userData.status == 'APPROVED';
    }

    // Helper function: Check if current user is an APPROVED doctor
    function isApprovedDoctor() {
      return isDoctor() && isApproved();
    }

    // Helper function: Check if current user is an APPROVED pharmacy
    function isApprovedPharmacy() {
      return isPharmacy() && isApproved();
    }

    // Helper function: Check if doctor is assigned to patient (multi-doctor support)
    // Safely handles missing assignedDoctors field on legacy patient docs
    // REQUIRES the doctor account to be APPROVED
    function isDoctorAssignedToPatient(patientId) {
      let patientData = getUserData(patientId);
      return isApprovedDoctor() &&
             'assignedDoctors' in patientData &&
             request.auth.uid in patientData.assignedDoctors;
    }

    // Helper function: Patient can read appointment schedule for assigned doctors
    // Used by booking flow to compute available slots from occupied appointment times.
    function canPatientReadAssignedDoctorSchedule(doctorId) {
      let me = getUserData(request.auth.uid);
      return isAuthenticated() &&
             me.role == 'PATIENT' &&
             'assignedDoctors' in me &&
             doctorId in me.assignedDoctors;
    }

    // Helper function: Patient can read profile of assigned doctors only.
    function canPatientReadAssignedDoctorProfile(targetUserId) {
      let me = getUserData(request.auth.uid);
      let target = getUserData(targetUserId);
      return isAuthenticated() &&
             me.role == 'PATIENT' &&
             target.role == 'DOCTOR' &&
             'assignedDoctors' in me &&
             targetUserId in me.assignedDoctors;
    }

    // Helper function: Check if current pharmacy user owns the given pharmacy
    // Used for cross-tenant isolation — ensures pharmacy A cannot access pharmacy B's data
    function isPharmacyOwner(pharmacyId) {
      return isApprovedPharmacy() &&
             get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.ownerId == request.auth.uid;
    }

    // Helper function: Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Helper: Validate order status transitions (state machine)
    function isValidOrderTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return (current == 'PENDING'         && next in ['CONFIRMED', 'CANCELLED']) ||
             (current == 'CONFIRMED'       && next in ['PREPARING', 'CANCELLED']) ||
             (current == 'PREPARING'       && next in ['READY', 'SHIPPED', 'CANCELLED']) ||
             (current == 'READY'           && next in ['SHIPPED', 'CANCELLED']) ||
             (current == 'SHIPPED'         && next in ['DELIVERED']) ||
             (current == 'DELIVERED'       && next in ['RETURNED']);
    }

    // Helper: Validate medicine fields
    function isValidMedicine() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.dosage is string && d.dosage.size() <= 100
          && d.userId is string;
    }

    // Helper: Validate health log fields
    function isValidHealthLog() {
      let d = request.resource.data;
      return d.userId is string
          && d.date is timestamp;
    }

    // Helper: Validate user fields on create
    function isValidUserCreate() {
      let d = request.resource.data;
      return d.email is string && d.email.size() > 0 && d.email.size() <= 320
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 100
          && d.role is string && d.role in ['PATIENT', 'DOCTOR', 'PHARMACY'];
    }

    // ==================== Users Collection ====================
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read any profile (user management)
      // Doctors can read profiles of their assigned patients
      // Pharmacy users: Removed - they don't need user profile access if order has delivery address
      // (If pharmacy needs to contact patient, use order.patientPhone/patientEmail instead)
      allow read: if isOwner(userId) ||
                  isAdmin() ||
                  isDoctorAssignedToPatient(userId) ||
                  canPatientReadAssignedDoctorProfile(userId);

      // Users can only create their own document
      // ADMIN role creation is blocked from client SDKs entirely
      // Admin accounts must be created server-side via Firebase Admin SDK
      allow create: if isOwner(userId) &&
                    hasRequiredFields(['email', 'displayName', 'role']) &&
                    isValidUserCreate();

      // Users can only update their own document
      // Cannot change their own role or status after creation
      // Admins can update any user (including role and status changes)
      allow update: if isAdmin() ||
                    (isOwner(userId) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'verifiedBy', 'verifiedAt', 'rejectionReason']));

      // Users can only delete their own document
      // Admins can delete any user
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ==================== Medicines Collection ====================
    match /medicines/{medicineId} {
      // Users can read their own medicines
      // Doctors can read medicines of their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isDoctorAssignedToPatient(resource.data.userId)
      );

      // Users can create medicines with their own userId
      // Doctors can create medicines for their assigned patients (prescriptions)
      allow create: if isAuthenticated() &&
                    hasRequiredFields(['userId', 'name', 'dosage']) &&
                    isValidMedicine() &&
                    (
                      request.resource.data.userId == request.auth.uid ||
                      isDoctorAssignedToPatient(request.resource.data.userId)
                    );

      // Users can update their own medicines
      // Doctors can update medicines for their assigned patients
      // Cannot change userId after creation
      allow update: if isAuthenticated() &&
                    request.resource.data.userId == resource.data.userId &&
                    (
                      resource.data.userId == request.auth.uid ||
                      isDoctorAssignedToPatient(resource.data.userId)
                    );

      // Users can delete their own medicines
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // ==================== Health Logs Collection ====================
    match /healthLogs/{logId} {
      // Users can read their own health logs
      // Doctors can read logs of their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isDoctorAssignedToPatient(resource.data.userId)
      );

      // Users can create health logs with their own userId
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    hasRequiredFields(['userId', 'date']) &&
                    isValidHealthLog();

      // Users can update their own health logs
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == resource.data.userId;

      // Users can delete their own health logs
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // ==================== Doctor Notes Collection ====================
    match /doctorNotes/{noteId} {
      // Doctors can read notes where they are the doctor
      // Patients can read non-private notes about themselves
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        (resource.data.patientId == request.auth.uid && resource.data.isPrivate == false)
      );

      // Only approved doctors can create notes
      // Doctor must be assigned to the patient
      allow create: if isApprovedDoctor() &&
                    request.resource.data.doctorId == request.auth.uid &&
                    isDoctorAssignedToPatient(request.resource.data.patientId) &&
                    hasRequiredFields(['doctorId', 'patientId', 'note']);

      // Doctors can only update their own notes
      allow update: if isAuthenticated() &&
                    resource.data.doctorId == request.auth.uid &&
                    request.resource.data.doctorId == resource.data.doctorId &&
                    request.resource.data.patientId == resource.data.patientId;

      // Doctors can only delete their own notes
      allow delete: if isAuthenticated() &&
                    resource.data.doctorId == request.auth.uid;
    }

    // ==================== Prescriptions Collection ====================
    match /prescriptions/{prescriptionId} {
      // Doctors can read prescriptions they authored
      // Patients can read their own prescriptions
      // APPROVED Pharmacy users can read prescription (needed to verify orders)
      // Note: For Firestore rules limitations, we only check APPROVED status here.
      // More granular filtering (specific pharmacy for specific patient) should be enforced
      // at application level since complex query validation is not supported in rules.
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        isApprovedPharmacy()
      );

      // Only approved doctors can create prescriptions for their assigned patients
      allow create: if isApprovedDoctor() &&
                    request.resource.data.doctorId == request.auth.uid &&
                    isDoctorAssignedToPatient(request.resource.data.patientId) &&
                    hasRequiredFields(['patientId', 'doctorId', 'medicationName', 'dosage']);

      // Only the prescribing approved doctor can update; patientId and doctorId are immutable
      allow update: if isApprovedDoctor() &&
                    resource.data.doctorId == request.auth.uid &&
                    request.resource.data.patientId == resource.data.patientId &&
                    request.resource.data.doctorId == resource.data.doctorId;

      // Prescriptions are never deleted — they form the audit trail
      allow delete: if false;
    }

    // ==================== Clinical Decisions Collection ====================
    match /clinicalDecisions/{decisionId} {
      // Doctors can read decisions where they are the doctor
      // Patients can read public decisions about themselves
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        (resource.data.patientId == request.auth.uid && resource.data.isPublic == true)
      );

      // Only approved doctors can create clinical decisions
      // Doctor must be assigned to the patient
      allow create: if isApprovedDoctor() &&
                    request.resource.data.doctorId == request.auth.uid &&
                    isDoctorAssignedToPatient(request.resource.data.patientId) &&
                    hasRequiredFields(['doctorId', 'patientId', 'type', 'title']);

      // Doctors can update their own decisions
      // Patients can update only acknowledgment fields
      allow update: if isAuthenticated() && (
        (resource.data.doctorId == request.auth.uid &&
         request.resource.data.doctorId == resource.data.doctorId &&
         request.resource.data.patientId == resource.data.patientId) ||
        (resource.data.patientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientAcknowledged', 'acknowledgedAt']))
      );

      // Only doctors can delete their own decisions
      allow delete: if isAuthenticated() &&
                    resource.data.doctorId == request.auth.uid;
    }

    // ==================== Medicine Intakes Collection ====================
    // Tracks adherence: each doc = one "medicine taken" event
    match /medicineIntakes/{intakeId} {
      // Users can read their own intake records
      // Doctors can read intakes for their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isDoctorAssignedToPatient(resource.data.userId)
      );

      // Users can log their own intakes
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    hasRequiredFields(['userId', 'medicineId']);

      // Intake records are immutable
      allow update, delete: if false;
    }

    // ==================== Audit Logs Collection ====================
    match /auditLogs/{logId} {
      // Audit logs are append-only by the system
      // Users can read their own logs; Admins can read all logs
      allow read: if isAuthenticated() &&
                  (resource.data.userId == request.auth.uid || isAdmin());

      // Any authenticated user can create audit logs
      // userId in the document MUST match the authenticated user's UID
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Audit logs cannot be updated or deleted
      allow update, delete: if false;
    }

    // ==================== Conversations Collection ====================
    match /conversations/{conversationId} {
      // Only participants can read
      allow read: if isAuthenticated() &&
                  request.auth.uid in resource.data.participantIds;

      // Any authenticated user can create a conversation they participate in
      allow create: if isAuthenticated() &&
                    request.auth.uid in request.resource.data.participantIds;

      // Only participants can update (for lastMessage, unread counters)
      allow update: if isAuthenticated() &&
                    request.auth.uid in resource.data.participantIds;

      // No deletion
      allow delete: if false;
    }

    // ==================== Messages Collection ====================
    match /messages/{messageId} {
      // Participants of the parent conversation can read messages
      allow read: if isAuthenticated() &&
                  request.auth.uid in
                    get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;

      // Authenticated user can create a message if they are a participant
      // and the senderId matches their auth UID
      allow create: if isAuthenticated() &&
                    request.resource.data.senderId == request.auth.uid &&
                    request.auth.uid in
                      get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds;

      // Only read receipts can be updated (isRead, readAt)
      allow update: if isAuthenticated() &&
                    request.auth.uid in
                      get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);

      allow delete: if false;
    }

    // ==================== Doctor Availability Collection ====================
    match /doctorAvailability/{slotId} {
      // Any authenticated user can read availability (needed for booking UI)
      allow read: if isAuthenticated();

      // Only the owning approved doctor can create
      allow create: if isApprovedDoctor() &&
                    request.resource.data.doctorId == request.auth.uid;

      // Only the owning approved doctor can update
      allow update: if isApprovedDoctor() &&
                    resource.data.doctorId == request.auth.uid &&
                    request.resource.data.doctorId == resource.data.doctorId;

      // Only the owning approved doctor can delete
      allow delete: if isApprovedDoctor() &&
                    resource.data.doctorId == request.auth.uid;
    }

    // ==================== Appointments Collection ====================
    match /appointments/{appointmentId} {
      // Only participants and admins can read appointments
      // Slot availability checking should use doctorAvailability collection (open read)
      allow read: if isAuthenticated() &&
                  (resource.data.doctorId == request.auth.uid ||
                   resource.data.patientId == request.auth.uid ||
                   canPatientReadAssignedDoctorSchedule(resource.data.doctorId) ||
                   isAdmin());

      // Patients or doctors can create appointments (booking)
      // Patient-initiated: patientId must match the authenticated user
      // Doctor-initiated: doctorId must match the authenticated user
      allow create: if isAuthenticated() &&
                    hasRequiredFields(['doctorId', 'patientId', 'date', 'startTime']) &&
                    (
                      request.resource.data.patientId == request.auth.uid ||
                      request.resource.data.doctorId == request.auth.uid
                    );

      // Either doctor or patient can update (confirm, reject, cancel, reschedule)
      // Core identity fields (doctorId, patientId) are immutable
      allow update: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );

      // No deletion — appointments form an audit trail
      allow delete: if false;
    }

    // ==================== Refill Orders Collection ====================
    match /orders/{orderId} {
      // Users can read their own orders
      // Pharmacy users can read orders assigned to their pharmacy only
      // Admins can read all orders
      allow read: if isAuthenticated() &&
                  (resource.data.userId == request.auth.uid ||
                   isAdmin() ||
                   (isApprovedPharmacy() && isPharmacyOwner(resource.data.pharmacyId)));

      // Users can create orders with their own userId
      // SECURITY: Must include pharmacyId to prevent orphaned orders
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    hasRequiredFields(['userId', 'medicineId', 'medicineName', 'quantity', 'status', 'pharmacyId']) &&
                    request.resource.data.pharmacyId != null &&
                    request.resource.data.pharmacyId != '';

      // Users can update their own orders (cancellation)
      // Pharmacy users can update only their own pharmacy's orders
      // Admins can update any order
      allow update: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid ||
                     isAdmin() ||
                     (isApprovedPharmacy() && isPharmacyOwner(resource.data.pharmacyId))) &&
                    isValidOrderTransition();

      // Orders are never deleted — they form an audit trail
      allow delete: if false;
    }

    // ==================== Pharmacies Collection ====================
    match /pharmacies/{pharmacyId} {
      // All authenticated users can browse pharmacies
      allow read: if isAuthenticated();

      // Pharmacy-role users (approved) can create their own pharmacy (ownerId must match)
      // Admins can create any pharmacy
      allow create: if isAuthenticated() &&
                    (isAdmin() ||
                     (isApprovedPharmacy() && request.resource.data.ownerId == request.auth.uid));

      // Approved pharmacy owners can update their own pharmacy
      // Admins can update any pharmacy
      allow update: if isAuthenticated() &&
                    (isAdmin() ||
                     (isApprovedPharmacy() && resource.data.ownerId == request.auth.uid));

      // Only admins can delete pharmacies
      allow delete: if isAdmin();
    }

    // ==================== Pharmacy Inventory Collection ====================
    match /pharmacyInventory/{itemId} {
      // Anyone authenticated can read inventory (patients need to check availability)
      // Phase 6: Inventory matching requires patients to query pharmacy stock
      allow read: if isAuthenticated();

      // Pharmacy users can create inventory items for their own pharmacy
      allow create: if isApprovedPharmacy() &&
                    isPharmacyOwner(request.resource.data.pharmacyId);

      // Pharmacy users can update their own inventory items
      // pharmacyId is immutable after creation
      allow update: if isApprovedPharmacy() &&
                    isPharmacyOwner(resource.data.pharmacyId) &&
                    request.resource.data.pharmacyId == resource.data.pharmacyId;

      // Only owning pharmacy or admin can delete
      allow delete: if isAdmin() ||
                    (isApprovedPharmacy() && isPharmacyOwner(resource.data.pharmacyId));
    }

    // ==================== Transactions Collection ====================
    match /transactions/{transactionId} {
      // Users can read their own transactions
      // Pharmacy users can read only their own pharmacy's transactions
      // Admins can read all transactions
      allow read: if isAuthenticated() &&
                  (resource.data.userId == request.auth.uid ||
                   isAdmin() ||
                   (isApprovedPharmacy() && isPharmacyOwner(resource.data.pharmacyId)));

      // Users can create transactions for their own orders
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Transactions are immutable — no updates or deletes
      allow update, delete: if false;
    }

    // ==================== Risk Scores Collection ====================
    match /riskScores/{scoreId} {
      // Users can read their own risk scores
      // Doctors can read risk scores of their assigned patients
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isDoctorAssignedToPatient(resource.data.userId)
      );

      // Users can create risk scores with their own userId
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Risk scores are immutable — append-only historical record
      allow update, delete: if false;
    }

    // ==================== Refill Alerts Collection ====================
    // Stores low-stock and refill reminder alerts for patients
    match /refillAlerts/{alertId} {
      // Users can read their own refill alerts only
      allow read: if isAuthenticated() &&
                  resource.data.userId == request.auth.uid;

      // Users can create refill alerts for themselves
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Users can update their own alerts (dismiss, mark as read, etc.)
      // userId is immutable
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == resource.data.userId;

      // Users can delete their own alerts
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // ==================== Carts Collection ====================
    // Stores shopping carts for medicine orders
    match /carts/{cartId} {
      // Users can read their own cart only
      allow read: if isAuthenticated() &&
                  resource.data.userId == request.auth.uid;

      // Users can create their own cart
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;

      // Users can update their own cart
      // userId is immutable
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == resource.data.userId;

      // Users can delete their own cart
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // ==================== Delivery Tracking Collection ====================
    // Real-time GPS tracking for delivery persons while order is OUT_FOR_DELIVERY
    // One document per active delivery order: ongoing_{orderId}
    match /deliveryTracking/{trackingId} {
      // Patients can read tracking updates for their own orders (real-time listener)
      // Rule: Check if this tracking document belongs to a delivery of user's order
      allow read: if isAuthenticated() &&
                  exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
                  get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid;

      // Delivery person can create/update tracking for their active deliveries
      // Write permission: deliveryPersonId matches authenticated user OR
      // Coming from Delivery Location Service (all write operations)
      allow create, update: if isAuthenticated() &&
                            request.resource.data.deliveryPersonId == request.auth.uid &&
                            request.resource.data.orderId != "";

      // Only delivery persons can write tracking data (no patients, no direct deletes)
      allow delete: if false;
    }

    // ==================== Payments Collection (Razorpay) ====================
    // Stores payment order records from Razorpay integration
    // Reference: /payments/{paymentId}
    match /payments/{paymentId} {
      // Users can read their own payment records
      // Admins can read all payments for auditing
      allow read: if isAuthenticated() &&
                  (resource.data.userId == request.auth.uid || isAdmin());

      // Users can create payment records with their own userId
      // These are created by /ui/payment/PaymentActivity via RazorpayRepository
      allow create: if isAuthenticated() &&
                    hasRequiredFields(['userId', 'amount', 'currency']) &&
                    request.resource.data.userId == request.auth.uid;

      // Payments are immutable — no updates after creation
      // (Razorpay payment records cannot be modified, only viewed)
      allow update: if false;

      // Payments are never deleted — they form audit trail
      // (Regulatory requirement: payment records must be retained)
      allow delete: if false;
    }

    // ==================== Notification Preferences Collection ====================
    // Stores user notification settings: quiet hours, notification type toggles
    // Reference: /notificationPreferences/{userId}
    match /notificationPreferences/{userId} {
      // Users can read their own notification preferences
      // Admins can read all preferences
      allow read: if isAuthenticated() &&
                  (isOwner(userId) || isAdmin());

      // Users can create their own notification preference document
      allow create: if isAuthenticated() &&
                    isOwner(userId) &&
                    hasRequiredFields(['userId']);

      // Users can update their own notification preferences
      // userId is immutable after creation
      allow update: if isAuthenticated() &&
                    isOwner(userId) &&
                    request.resource.data.userId == resource.data.userId;

      // Only admins can delete notification preferences
      allow delete: if isAdmin();
    }

    // ==================== Cancellation Requests Collection ====================
    // Stores order cancellation requests with approval workflow and refund tracking
    // Reference: /cancellationRequests/{requestId}
    match /cancellationRequests/{requestId} {
      // Users can read their own cancellation requests
      // Pharmacies can read cancellation requests for their orders (approvals)
      // Admins can read all cancellation requests
      allow read: if isAuthenticated() &&
                  (resource.data.userId == request.auth.uid ||
                   isAdmin() ||
                   (isApprovedPharmacy() && exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
                    get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.get('pharmacyId', '') == getUserData(request.auth.uid).get('pharmacyId', '')));

      // Users can create cancellation requests for their own pending/confirmed/preparing orders
      allow create: if isAuthenticated() &&
                    hasRequiredFields(['userId', 'orderId', 'reason']) &&
                    request.resource.data.userId == request.auth.uid &&
                    exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId));

      // Pharmacies/Admins can update cancellation status for approval
      // Users cannot update their own requests once created
      allow update: if isAuthenticated() &&
                    (isAdmin() ||
                     (isApprovedPharmacy() && exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
                      get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.get('pharmacyId', '') == getUserData(request.auth.uid).get('pharmacyId', ''))) &&
                    // Only certain fields can be updated during approval
                    (request.resource.data.requestStatus != resource.data.requestStatus ||
                     request.resource.data.approvedBy != resource.data.approvedBy ||
                     request.resource.data.refundStatus != resource.data.refundStatus);

      // Cancellation requests cannot be deleted (they form audit trail)
      allow delete: if false;
    }

    // ==================== Deletion Requests Collection ====================
    // Stores user account deletion requests with 30-day grace period
    // Reference: /deletionRequests/{userId}
    match /deletionRequests/{userId} {
      // Users can read their own deletion request
      // Admins can read all deletion requests
      allow read: if isAuthenticated() &&
                  (isOwner(userId) || isAdmin());

      // Users can create deletion request for their own account
      allow create: if isAuthenticated() &&
                    isOwner(userId) &&
                    hasRequiredFields(['userId', 'requestedAt', 'scheduledDeleteDate', 'status']);

      // Users can update their own deletion request to cancel (within grace period)
      // Admins can update any deletion request
      allow update: if isAuthenticated() &&
                    (isAdmin() ||
                     (isOwner(userId) && request.resource.data.status == 'CANCELLED')) &&
                    isOwner(userId);

      // Deletion requests cannot be manually deleted (audit trail)
      allow delete: if false;
    }

    // ==================== Audit Logs Collection ====================
    // Immutable audit trail for compliance and debugging
    // Reference: /auditLogs/{docId}
    match /auditLogs/{docId} {
      // Admins can read audit logs
      // Users can read their own audit entries
      allow read: if isAuthenticated() &&
                  (isAdmin() ||
                   (resource.data.userId == request.auth.uid));

      // Only the system (via Cloud Functions) can create audit logs
      // But clients can also create for local actions
      allow create: if isAuthenticated() &&
                    hasRequiredFields(['action', 'timestamp']);

      // Audit logs are immutable (never update or delete)
      allow update: if false;
      allow delete: if false;
    }
  }
}




