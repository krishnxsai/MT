<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================ -->
    <!-- MediTrack Modern Medical Theme -->
    <!-- Clean, Professional, Accessible -->
    <!-- ============================================ -->

    <style name="Theme.MediTrack" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary color -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <!-- Background & Surface - Clean White -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error color -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/white</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>

        <!-- Status bar - Clean white -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Shape theming - Reduced corner radius for modern look -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MediTrack.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MediTrack.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MediTrack.LargeComponent</item>
    </style>

    <!-- Shape Appearances - Reduced corners for cleaner look -->
    <style name="ShapeAppearance.MediTrack.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.MediTrack.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.MediTrack.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.MediTrack.Splash" parent="Theme.MediTrack">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ============================================ -->
    <!-- Card Styles - Subtle shadows, clean design -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.MediTrack.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.MediTrack.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.MediTrack.CardView.Hero" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/primary</item>
    </style>

    <!-- ============================================ -->
    <!-- Button Styles -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.MediTrack.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MediTrack.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.MediTrack.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ============================================ -->
    <!-- Text Input Styles -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="hintTextAppearance">@style/TextAppearance.MediTrack.Hint</item>
    </style>

    <!-- ============================================ -->
    <!-- Typography - Strong Hierarchy -->
    <!-- ============================================ -->

    <!-- Display - For splash/hero numbers -->
    <style name="TextAppearance.MediTrack.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">48sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Headlines - Page titles -->
    <style name="TextAppearance.MediTrack.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MediTrack.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MediTrack.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Titles - Section headers -->
    <style name="TextAppearance.MediTrack.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="TextAppearance.MediTrack.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MediTrack.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Body - Content text -->
    <style name="TextAppearance.MediTrack.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.MediTrack.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.MediTrack.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Labels -->
    <style name="TextAppearance.MediTrack.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MediTrack.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MediTrack.Hint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- ============================================ -->
    <!-- Chip Styles -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipBackgroundColor">@color/surface_variant</item>
    </style>

    <style name="Widget.MediTrack.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ============================================ -->
    <!-- FAB Styles -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.MediTrack.MediumComponent</item>
    </style>

    <style name="Widget.MediTrack.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MediTrack.MediumComponent</item>
    </style>

    <!-- ============================================ -->
    <!-- Bottom Sheet -->
    <!-- ============================================ -->

    <style name="ThemeOverlay.MediTrack.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MediTrack.BottomSheet</item>
    </style>

    <style name="Widget.MediTrack.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.MediTrack.LargeComponent</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <!-- ============================================ -->
    <!-- Switch Style -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- ============================================ -->
    <!-- Toolbar -->
    <!-- ============================================ -->

    <style name="Widget.MediTrack.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.MediTrack.TitleMedium</item>
        <item name="android:background">@color/background</item>
    </style>

    <!-- ============================================ -->
    <!-- Premium Doctor UI Styles -->
    <!-- ============================================ -->

    <!-- Premium Tab Text Style -->
    <style name="PremiumTabText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Premium FAB Shape -->
    <style name="PremiumFabShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Premium Chip Choice Style -->
    <style name="PremiumChipChoice" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/premium_text_secondary</item>
        <item name="chipBackgroundColor">@color/premium_surface_dim</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconEnabled">false</item>
    </style>

    <!-- Premium Chip Priority Style -->
    <style name="PremiumChipPriority" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/premium_text_secondary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="checkedIconEnabled">false</item>
    </style>

    <!-- Premium Text Input Layout -->
    <style name="PremiumTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/premium_input_stroke</item>
        <item name="hintTextColor">@color/premium_text_tertiary</item>
        <item name="android:textColorHint">@color/premium_text_tertiary</item>
        <item name="boxBackgroundColor">@color/premium_input_background</item>
    </style>

    <!-- ============================================ -->
    <!-- Alarm Screen Theme -->
    <!-- ============================================ -->

    <style name="Theme.MediTrack.Alarm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/alarm_background</item>
        <item name="android:statusBarColor">@color/alarm_background</item>
        <item name="android:navigationBarColor">@color/alarm_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/alarm_button_take</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
</resources>