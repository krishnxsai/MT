<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/medicineCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp"
    app:rippleColor="@color/ripple_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Left Color Accent Strip -->
        <View
            android:id="@+id/colorStrip"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_marginVertical="2dp"
            android:background="@drawable/bg_rounded_4dp"
            android:backgroundTint="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hidden icon container (kept for binding) -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/medicineIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pill"
                app:tint="@color/primary" />

        </FrameLayout>

        <!-- Medicine Info Section -->
        <LinearLayout
            android:id="@+id/infoSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightSection"
            app:layout_constraintStart_toEndOf="@id/colorStrip"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Medicine Name -->
            <TextView
                android:id="@+id/medicineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-bold"
                tools:text="Aspirin" />

            <!-- Dosage -->
            <TextView
                android:id="@+id/dosageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="500mg" />

            <!-- Frequency -->
            <TextView
                android:id="@+id/frequencyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Twice daily" />

            <!-- Next Due Time -->
            <TextView
                android:id="@+id/reminderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Next due: 2:00 PM Today" />

            <!-- Stock Level Indicator -->
            <LinearLayout
                android:id="@+id/stockContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/stockProgressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/bg_stock_progress" />

                <TextView
                    android:id="@+id/stockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:text="12 left" />

            </LinearLayout>

            <!-- Low Stock Warning -->
            <TextView
                android:id="@+id/lowStockWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="4dp"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:text="⚠ Low stock — refill soon"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right Section: Status Badge -->
        <LinearLayout
            android:id="@+id/rightSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Status Badge (Pending / Taken) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/toggleContainer"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:cardBackgroundColor="@color/status_active_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/status_active"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/status_active"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Taken" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Hidden toggle icon (kept for binding) -->
            <ImageView
                android:id="@+id/toggleIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:src="@drawable/ic_check" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
