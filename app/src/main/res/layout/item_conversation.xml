<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/premium_surface_dim">

        <ImageView
            android:id="@+id/avatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            android:contentDescription="Avatar" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Name + Last message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/premium_text_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Dr. Sarah Johnson" />

        <TextView
            android:id="@+id/lastMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/premium_text_tertiary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Please take your medication on time" />

    </LinearLayout>

    <!-- Time + Unread badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/premium_text_tertiary"
            android:textSize="12sp"
            tools:text="10:30" />

        <TextView
            android:id="@+id/unreadBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="6dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="@color/premium_primary"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>

