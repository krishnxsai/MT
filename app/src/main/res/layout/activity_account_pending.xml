<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/statusIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_clock"
        app:tint="@color/warning"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/statusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/account_pending_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/account_pending_message"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:id="@+id/rejectionReasonLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/rejection_reason_label"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rejectionReasonText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Upload license button (visible if no license uploaded yet) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/uploadLicenseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/upload_license"
        android:textAllCaps="false"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_add"
        android:visibility="gone" />

    <TextView
        android:id="@+id/licenseUploadedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/license_uploaded"
        android:textColor="@color/success"
        android:textSize="14sp"
        android:drawablePadding="6dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/refreshButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/check_status"
        android:textAllCaps="false"
        app:cornerRadius="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/signOutButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sign_out"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>

