<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Premium Header with Gradient -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_header"
            android:paddingBottom="40dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:text="Patient Profile"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <!-- More Options -->
            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:visibility="gone"
                app:tint="@color/white" />

            <!-- Patient Info Card - Floating -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/patientHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="60dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="28dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Patient Avatar -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardBackgroundColor="@color/primary_container"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="3dp">

                        <ImageView
                            android:id="@+id/patientImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="22dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Patient Name -->
                    <TextView
                        android:id="@+id/patientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="John Doe" />

                    <!-- Patient Email -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/patientEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="john.doe@email.com" />

                    </LinearLayout>

                    <!-- Phone Number -->
                    <LinearLayout
                        android:id="@+id/phoneContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/patientPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="+1 234 567 8900" />

                    </LinearLayout>

                    <!-- Member Since Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/primary_container"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/memberSinceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            tools:text="Patient since Jan 2025" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_content_rounded_top"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Premium Tab Navigation -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    app:tabGravity="fill"
                    app:tabIndicator="@drawable/bg_tab_indicator"
                    app:tabIndicatorColor="@color/primary"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorGravity="stretch"
                    app:tabIndicatorHeight="0dp"
                    app:tabMode="fixed"
                    app:tabPaddingEnd="4dp"
                    app:tabPaddingStart="4dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextAppearance="@style/PremiumTabText"
                    app:tabTextColor="@color/text_secondary">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meds" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logs" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trends" />

                </com.google.android.material.tabs.TabLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Content Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp">

                <!-- Medicines Container -->
                <LinearLayout
                    android:id="@+id/medicinesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/medicinesCountText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_tertiary"
                            android:textSize="14sp"
                            tools:text="5 active medications" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addMedicineButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="+ Add"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/medicinesRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="140dp" />

                    <TextView
                        android:id="@+id/emptyMedicinesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="60dp"
                        android:drawableTop="@drawable/ic_medicine"
                        android:drawablePadding="16dp"
                        android:drawableTint="@color/text_hint"
                        android:gravity="center"
                        android:text="No medicines recorded"
                        android:textColor="@color/text_tertiary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Health Logs Container -->
                <LinearLayout
                    android:id="@+id/healthLogsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/healthLogsCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="14sp"
                        tools:text="12 health logs" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/healthLogsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="140dp" />

                    <TextView
                        android:id="@+id/emptyHealthLogsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="60dp"
                        android:drawableTop="@drawable/ic_health"
                        android:drawablePadding="16dp"
                        android:drawableTint="@color/text_hint"
                        android:gravity="center"
                        android:text="No health logs recorded"
                        android:textColor="@color/text_tertiary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Notes Container -->
                <LinearLayout
                    android:id="@+id/notesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/notesCountText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_tertiary"
                            android:textSize="14sp"
                            tools:text="3 clinical notes" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addNoteButtonHeader"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="+ Add Note"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/notesRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="140dp" />

                    <TextView
                        android:id="@+id/emptyNotesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="60dp"
                        android:drawableTop="@drawable/ic_notes"
                        android:drawablePadding="16dp"
                        android:drawableTint="@color/text_hint"
                        android:gravity="center"
                        android:text="No notes yet\nTap + to add a clinical note"
                        android:textAlignment="center"
                        android:textColor="@color/text_tertiary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Trends Container -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/trendsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="140dp">

                        <!-- Vitals Summary Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Heart Rate Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/outline_light"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="18dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <FrameLayout
                                            android:layout_width="36dp"
                                            android:layout_height="36dp"
                                            android:background="@drawable/bg_icon_soft"
                                            android:backgroundTint="#FEF2F2">

                                            <ImageView
                                                android:layout_width="18dp"
                                                android:layout_height="18dp"
                                                android:layout_gravity="center"
                                                android:src="@drawable/ic_heart"
                                                app:tint="@color/chart_heart_rate" />

                                        </FrameLayout>

                                        <ImageView
                                            android:id="@+id/hrTrendIcon"
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:layout_marginStart="8dp"
                                            android:src="@drawable/ic_trending_flat"
                                            app:tint="@color/text_tertiary" />

                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="Heart Rate"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/trendHeartRate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/text_primary"
                                        android:textSize="22sp"
                                        android:fontFamily="sans-serif-medium"
                                        tools:text="72 bpm" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Blood Pressure Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/surface"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/outline_light"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="18dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <FrameLayout
                                            android:layout_width="36dp"
                                            android:layout_height="36dp"
                                            android:background="@drawable/bg_icon_soft"
                                            android:backgroundTint="#EFF6FF">

                                            <ImageView
                                                android:layout_width="18dp"
                                                android:layout_height="18dp"
                                                android:layout_gravity="center"
                                                android:src="@drawable/ic_health"
                                                app:tint="@color/chart_bp_systolic" />

                                        </FrameLayout>

                                        <ImageView
                                            android:id="@+id/bpTrendIcon"
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:layout_marginStart="8dp"
                                            android:src="@drawable/ic_trending_flat"
                                            app:tint="@color/text_tertiary" />

                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="Blood Pressure"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/trendBloodPressure"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/text_primary"
                                        android:textSize="22sp"
                                        android:fontFamily="sans-serif-medium"
                                        tools:text="120/80" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Heart Rate Chart -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/outline_light"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:layout_width="4dp"
                                        android:layout_height="20dp"
                                        android:background="@drawable/bg_rounded_4dp"
                                        android:backgroundTint="@color/chart_heart_rate" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:text="Heart Rate Trend"
                                        android:textColor="@color/text_primary"
                                        android:textSize="16sp"
                                        android:fontFamily="sans-serif-medium" />

                                </LinearLayout>

                                <com.github.mikephil.charting.charts.LineChart
                                    android:id="@+id/patientHeartRateChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="180dp"
                                    android:layout_marginTop="16dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Blood Pressure Chart -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/outline_light"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:layout_width="4dp"
                                        android:layout_height="20dp"
                                        android:background="@drawable/bg_rounded_4dp"
                                        android:backgroundTint="@color/chart_bp_systolic" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:text="Blood Pressure Trend"
                                        android:textColor="@color/text_primary"
                                        android:textSize="16sp"
                                        android:fontFamily="sans-serif-medium" />

                                </LinearLayout>

                                <com.github.mikephil.charting.charts.LineChart
                                    android:id="@+id/patientBloodPressureChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="180dp"
                                    android:layout_marginTop="16dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Glucose Chart -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/outline_light"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:layout_width="4dp"
                                        android:layout_height="20dp"
                                        android:background="@drawable/bg_rounded_4dp"
                                        android:backgroundTint="@color/chart_glucose" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:text="Glucose Trend"
                                        android:textColor="@color/text_primary"
                                        android:textSize="16sp"
                                        android:fontFamily="sans-serif-medium" />

                                </LinearLayout>

                                <com.github.mikephil.charting.charts.LineChart
                                    android:id="@+id/patientGlucoseChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="180dp"
                                    android:layout_marginTop="16dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_fade"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Clinical Decision Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clinicalDecisionButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_gradient"
            android:text="🩺  Create Clinical Decision"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@null"
            app:cornerRadius="30dp"
            app:elevation="8dp"
            app:icon="@drawable/ic_insights"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

    </LinearLayout>

    <!-- FAB for adding notes (shown only on Notes tab) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addNoteFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="100dp"
        android:contentDescription="Add note"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:tint="@color/white" />

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

