<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="top">

        <!-- Icon -->
        <FrameLayout
            android:id="@+id/suggestionIconBg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_container"
            android:backgroundTint="@color/primary_container">

            <ImageView
                android:id="@+id/suggestionIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_insights"
                app:tint="@color/primary" />

        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row with priority badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/suggestionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="Schedule a Doctor Visit" />

                <TextView
                    android:id="@+id/suggestionPriorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_4dp"
                    android:backgroundTint="@color/warning_container"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/warning"
                    android:textSize="9sp"
                    tools:text="HIGH" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/suggestionDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.3"
                tools:text="Your health risk score is elevated. Consider booking an appointment." />

            <!-- Action type chip -->
            <TextView
                android:id="@+id/suggestionActionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_4dp"
                android:backgroundTint="@color/surface_variant"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                tools:text="Doctor Visit" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

