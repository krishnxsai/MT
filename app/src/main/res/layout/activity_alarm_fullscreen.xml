<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background"
    android:padding="24dp">

    <!-- Pulsing alarm icon -->
    <ImageView
        android:id="@+id/alarmIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ic_alarm_pill"
        android:contentDescription="@string/alarm_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/alarm_icon_color" />

    <!-- Alarm title -->
    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/medicine_reminder"
        android:textColor="@color/alarm_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarmIcon" />

    <!-- Medicine name -->
    <TextView
        android:id="@+id/medicineNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/alarm_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="Aspirin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarmTitle" />

    <!-- Dosage info -->
    <TextView
        android:id="@+id/dosageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/alarm_text_secondary"
        android:textSize="20sp"
        android:gravity="center"
        tools:text="Dosage: 500mg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/medicineNameText" />

    <!-- Current time -->
    <TextView
        android:id="@+id/alarmTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/alarm_text_secondary"
        android:textSize="18sp"
        tools:text="Time: 8:00 AM"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dosageText" />

    <!-- Button container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Take button - Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/takeButton"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:text="@string/take_medicine"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@color/alarm_button_take"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp" />

        <!-- Snooze button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/snoozeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/snooze_10_min"
            android:textColor="@color/alarm_text_primary"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_clock"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/alarm_text_primary"
            app:strokeColor="@color/alarm_text_secondary"
            app:strokeWidth="2dp" />

        <!-- Skip button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skipButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="280dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/skip_this_dose"
            android:textColor="@color/alarm_text_secondary"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

