<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Location Permissions (for nearby pharmacies & delivery tracking) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Alarm & Notification Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service Permission (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Full-screen intent permission (Android 10+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Disable battery optimization for reliable alarms -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MediTrackApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediTrack"
        tools:targetApi="31">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MediTrack.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.AccountPendingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.HomeDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Medicine Activities -->
        <activity
            android:name=".ui.medicine.MedicinesListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.medicine.AddMedicineActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Health Log Activities -->
        <activity
            android:name=".ui.healthlog.HealthLogListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.healthlog.AddHealthLogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Insights Activity -->
        <activity
            android:name=".ui.insights.HealthInsightsActivity"
            android:exported="false" />

        <!-- Risk Dashboard Activity -->
        <activity
            android:name=".ui.insights.RiskDashboardActivity"
            android:exported="false" />

        <!-- Doctor Activities -->
        <activity
            android:name=".ui.doctor.DoctorDashboardActivity"
            android:exported="false" />

        <!-- Admin Dashboard -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <!-- Pharmacy Dashboard -->
        <activity
            android:name=".ui.pharmacy.PharmacyDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pharmacy.PharmacyProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.pharmacy.InventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.pharmacy.TransactionHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.doctor.PatientDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.doctor.ClinicalDecisionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Patient Recommendations Activity -->
        <activity
            android:name=".ui.recommendations.DoctorRecommendationsActivity"
            android:exported="false" />

        <!-- Chat Activities -->
        <activity
            android:name=".ui.chat.ChatListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Appointment Activities -->
        <activity
            android:name=".ui.appointment.AppointmentsListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.appointment.AppointmentBookingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.appointment.DoctorAvailabilityActivity"
            android:exported="false" />

        <!-- Refill Orders Activity -->
        <activity
            android:name=".ui.order.RefillOrdersActivity"
            android:exported="false" />

        <!-- Pharmacy List Activity -->
        <activity
            android:name=".ui.order.PharmacyListActivity"
            android:exported="false" />

        <!-- Unified Medicine Order Activity -->
        <activity
            android:name=".ui.order.unified.UnifiedOrderActivity"
            android:exported="false"
            android:label="Medicine Orders" />

        <!-- Pharmacy Map Activity -->
        <activity
            android:name=".ui.order.unified.PharmacyMapActivity"
            android:exported="false"
            android:label="Select Pharmacy" />

        <!-- Order Tracking Activity -->
        <activity
            android:name=".ui.order.OrderTrackingActivity"
            android:exported="false"
            android:label="Order Tracking" />

        <!-- Order History Activity -->
        <activity
            android:name=".ui.order.history.OrderHistoryActivity"
            android:exported="false"
            android:label="My Orders" />

        <!-- Payment Activity (Razorpay) -->
        <activity
            android:name=".ui.payment.PaymentActivity"
            android:exported="false"
            android:label="Payment"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification Settings Activity -->
        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false"
            android:label="Notification Settings" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />

        <!-- Razorpay API Key -->
        <!-- NOTE: This is REQUIRED meta-data for Razorpay SDK initialization.
             The value is injected at build time via manifestPlaceholders in build.gradle.kts

             Razorpay SDK validates this meta-data exists, so it MUST have an actual value,
             not a string resource reference (SDK cannot resolve @string references reliably).

             Architecture:
             1. build.gradle.kts injects key via manifestPlaceholders["razorpay_key_value"]
             2. AndroidManifest.xml uses ${razorpay_key_value} placeholder
             3. Razorpay SDK reads the resolved value at runtime (case-sensitive key name)
             4. Checkout options use Remote Config key at runtime, with this as bootstrap fallback
        -->
        <meta-data
            android:name="com.razorpay.ApiKey"
            android:value="${razorpay_key_value}" />

        <!-- Temporary alias for older app assumptions. Remove after one stable release cycle. -->
        <meta-data
            android:name="com.razorpay.api_key"
            android:value="${razorpay_key_value}" />

        <!-- Full-Screen Alarm Activity -->
        <activity
            android:name=".alarm.AlarmFullScreenActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@style/Theme.MediTrack.Alarm" />

        <!-- Alarm Foreground Service -->
        <service
            android:name=".alarm.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".fcm.MediTrackFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Delivery Location Service (Real-time GPS tracking) -->
        <service
            android:name=".service.DeliveryLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Broadcast Receivers -->
        <receiver
            android:name=".alarm.MedicineAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot Receiver for rescheduling alarms after device restart -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>