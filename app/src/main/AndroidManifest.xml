<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Location Permissions (for nearby pharmacies) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Alarm & Notification Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service Permission (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Full-screen intent permission (Android 10+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Disable battery optimization for reliable alarms -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MediTrackApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediTrack"
        tools:targetApi="31">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MediTrack.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.AccountPendingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.HomeDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Medicine Activities -->
        <activity
            android:name=".ui.medicine.MedicinesListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.medicine.AddMedicineActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Health Log Activities -->
        <activity
            android:name=".ui.healthlog.HealthLogListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.healthlog.AddHealthLogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Insights Activity -->
        <activity
            android:name=".ui.insights.HealthInsightsActivity"
            android:exported="false" />

        <!-- Risk Dashboard Activity -->
        <activity
            android:name=".ui.insights.RiskDashboardActivity"
            android:exported="false" />

        <!-- Doctor Activities -->
        <activity
            android:name=".ui.doctor.DoctorDashboardActivity"
            android:exported="false" />

        <!-- Admin Dashboard -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <!-- Pharmacy Dashboard -->
        <activity
            android:name=".ui.pharmacy.PharmacyDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pharmacy.PharmacyProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.pharmacy.InventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.pharmacy.TransactionHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.doctor.PatientDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.doctor.ClinicalDecisionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Patient Recommendations Activity -->
        <activity
            android:name=".ui.recommendations.DoctorRecommendationsActivity"
            android:exported="false" />

        <!-- Chat Activities -->
        <activity
            android:name=".ui.chat.ChatListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Appointment Activities -->
        <activity
            android:name=".ui.appointment.AppointmentsListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.appointment.AppointmentBookingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.appointment.DoctorAvailabilityActivity"
            android:exported="false" />

        <!-- Refill Orders Activity -->
        <activity
            android:name=".ui.order.RefillOrdersActivity"
            android:exported="false" />

        <!-- Pharmacy List Activity -->
        <activity
            android:name=".ui.order.PharmacyListActivity"
            android:exported="false" />

        <!-- Unified Medicine Order Activity -->
        <activity
            android:name=".ui.order.unified.UnifiedOrderActivity"
            android:exported="false"
            android:label="Medicine Orders" />

        <!-- Pharmacy Map Activity -->
        <activity
            android:name=".ui.order.unified.PharmacyMapActivity"
            android:exported="false"
            android:label="Select Pharmacy" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />

        <!-- Full-Screen Alarm Activity -->
        <activity
            android:name=".alarm.AlarmFullScreenActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@style/Theme.MediTrack.Alarm" />

        <!-- Alarm Foreground Service -->
        <service
            android:name=".alarm.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Broadcast Receivers -->
        <receiver
            android:name=".alarm.MedicineAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot Receiver for rescheduling alarms after device restart -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>